# Environment variables for deployment
# Copy to Netlify / host UI or local `.env.local` (DO NOT COMMIT real secrets)

# Required — public Supabase keys (safe in the browser; used by forms + admin)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional aliases (same values as above)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional — server-only (bypasses RLS). Prefer setting this in production.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — branded SMTP later (Yahoo app password)
# SMTP_PASS=

PUBLIC_SITE_URL=
NODE_ENV=production
